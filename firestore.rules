rules_version = '2';

// Best-effort enforcement for a Spark-plan (no Cloud Functions) deployment.
// There is no trusted server: everything here is what a signed-in client can be
// made to prove using only its own auth token and document reads.
//
// Identity is a *verified email address*, established by Firebase's
// passwordless email-link sign-in. The auctioneer invites an address; the
// person who can read that inbox gets the seat, on any device, as often as they
// like. Nothing in a URL grants access, so a forwarded link is worthless and a
// supplier who clears their cookies mid-auction simply signs in again.
//
// What this CANNOT do — deliberately accepted trade-offs, see project notes:
//   - Blind Last-Call secrecy: a technical reader can list `events` directly
//     and see hidden bids; the client only hides them at render time.
//   - Bid arithmetic (beats-current-best, extended-time math, min-step):
//     enforced client-side only (`validateInbound`), not re-derived here.
// What this DOES enforce: only an auctioneer can issue admin events, only a
// seated bidder can bid as itself, a supplier can withdraw only their own bid,
// an observer can write nothing at all, events are append-only, only the
// auctioneer can seat or unseat anyone, and — see `identities` below — a
// supplier cannot read any other supplier's name or email by any route.
service cloud.firestore {
  match /databases/{database}/documents {

    match /auctions/{auctionId} {

      function auction() {
        return get(/databases/$(database)/documents/auctions/$(auctionId)).data;
      }

      // ---- identity -------------------------------------------------------
      //
      // The writer's seat, looked up by the verified address on their token.
      // This replaces the old uid-keyed `claims` mirror: because the seat is
      // keyed by email rather than by browser session, revoking it (deleting
      // the doc) takes effect immediately and everywhere, and a second device
      // needs no new capability.

      function seatPath() {
        return /databases/$(database)/documents/auctions/$(auctionId)/seats/$(request.auth.token.email);
      }

      // `email_verified` is the load-bearing check. Email-link sign-in sets it;
      // without it, any sign-in method that let a caller assert an unverified
      // address would hand them someone else's seat.
      function hasSeat() {
        return request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && exists(seatPath());
      }

      function seat() {
        return get(seatPath()).data;
      }

      // The auction's creator, plus anyone they later seated as an auctioneer.
      // (`ownerUid` alone is kept so auction creation has a bootstrap identity
      // before any seat exists.)
      function isOwner() {
        return request.auth != null
          && (auction().ownerUid == request.auth.uid || (hasSeat() && seat().role == 'owner'));
      }

      function isBidder() {
        return hasSeat() && seat().role == 'bidder';
      }

      allow get: if request.auth != null;
      // No `list` on the auction collection itself — auctions are only ever
      // opened by a known id (from a URL), never enumerated.
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.nextSeq == 0
        && request.resource.data.startedAt == null
        && request.resource.data.showResults == false;

      allow update: if (
        isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        // seq only ever moves forward; mirror fields (name/startedAt/
        // auctionLength/showResults) are cosmetic and owner-trusted.
        && request.resource.data.nextSeq >= resource.data.nextSeq
        // rules are frozen once the auction has actually started.
        && (resource.data.startedAt == null || request.resource.data.config == resource.data.config)
      ) || (
        // A bidder's own placeBid submit() bumps this same mirrored counter
        // (and, on Extended Time, auctionLength) alongside their event write —
        // both writes land in one commit. Bid arithmetic is already
        // client-trusted (see isAllowedBid), so trust the paired bump too:
        // only nextSeq/auctionLength may move, and nextSeq by exactly one.
        //
        // auctionLength is the clock every participant reads, so unlike the
        // other mirror fields it is NOT owner-trusted here and must be bounded:
        // a bidder who could write it freely would be able to end the auction
        // for everyone (0) or stall it indefinitely. Extended Time only ever
        // pushes the main clock back out to the threshold, so the largest
        // legitimate bump is the threshold itself, and it never moves backwards.
        isBidder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextSeq', 'auctionLength'])
        && request.resource.data.nextSeq == resource.data.nextSeq + 1
        && request.resource.data.auctionLength >= resource.data.auctionLength
        && request.resource.data.auctionLength <= resource.data.auctionLength
             + resource.data.config.extendedTimeThresholdSec
      );

      allow delete: if false;

      // ---- events/{eventId} : append-only log -----------------------------
      match /events/{eventId} {
        allow get, list: if request.auth != null;
        allow update, delete: if false;

        allow create: if request.auth != null
          && request.resource.data.seq == auction().nextSeq
          && isAllowedEvent();

        function isAllowedEvent() {
          let type = request.resource.data.type;
          let ownerOnly = type in
            ['setName', 'addUser', 'addLot', 'renameLot', 'startAuction', 'showResults'];
          return (ownerOnly && isOwner())
            || (type == 'placeBid' && isAllowedBid())
            || (type == 'cancelBid' && isAllowedCancel());
        }

        // The auctioneer may withdraw any bid; a supplier only their own. A
        // cancellation names the bid's owner in `bidder` — rules cannot follow
        // `bidSeq` to the bid document, so this checks the *seat* against that
        // name, and the client fold refuses any cancellation whose named owner
        // is not the target bid's actual bidder. A supplier can therefore only
        // write a cancellation naming themselves, which can only ever take
        // effect on one of their own bids.
        function isAllowedCancel() {
          return isOwner() || (isBidder() && request.resource.data.bidder == seat().publicKey);
        }

        function isAllowedBid() {
          let data = request.resource.data;
          let withinWindow = auction().startedAt != null
            // small grace window for clock drift / in-flight requests, not a
            // meaningful security boundary given everything else here.
            && request.time.toMillis() / 1000 <= auction().startedAt + auction().auctionLength + 5;
          let onBehalf = 'placedBy' in data;
          let asSelf = isBidder() && seat().publicKey == data.bidder;
          return withinWindow && (onBehalf ? isOwner() : asSelf);
        }
      }

      // ---- users/{publicKey} : the public roster --------------------------
      //
      // Readable by any signed-in client, because a viewer resolves their own
      // slot here before anything else is known about them. That is only safe
      // because these docs carry nothing identifying — just the role, the
      // public label ("Supplier C") and the palette slot. Names and email
      // addresses live in `identities` and `seats`, both closed to a rival.
      match /users/{publicKey} {
        // No `list`: the roster is derived client-side by folding `addUser`
        // events, so nothing legitimate ever queries this collection.
        allow get: if request.auth != null;
        allow list: if false;

        allow create: if isOwner();
        // Immutable once written. Who *occupies* a slot is now a property of
        // the seat, not of this doc, so there is nothing here left to change.
        allow update, delete: if false;
      }

      // ---- identities/{publicKey} : real names, access-controlled ---------
      //
      // The one collection in this app that is genuinely secret from a
      // supplier. Everything else — the log, the roster, the bids — is
      // readable by any signed-in client, so a supplier's firm cannot be
      // stored in any of them. It lives here instead, and this rule is what
      // enforces the auction's core promise: a bidder learns where their price
      // stands in the market, and never whose price it is standing against.
      //
      // Readable by the auctioneer (who runs the auction), an observer (the
      // buying side, who sees the auctioneer's screen), and the participant
      // themselves. Never by another bidder — not before the auction, not
      // during it, and not after results are released.
      match /identities/{publicKey} {
        allow get: if isOwner()
          || (hasSeat() && (seat().role == 'viewer' || seat().publicKey == publicKey));
        allow list: if isOwner() || (hasSeat() && seat().role == 'viewer');
        allow create: if isOwner();
        // Immutable: a rename would otherwise let the auctioneer's screen and a
        // supplier's own screen disagree about who bid what after the fact.
        allow update, delete: if false;
      }

      // ---- seats/{email} : who may occupy which slot ----------------------
      //
      // The access-control table, keyed by the invited address so that a
      // sign-in token can be checked against it directly. Deleting a seat is
      // how the auctioneer revokes someone; creating one under a different
      // address is how they correct a typo in an invitation.
      //
      // A seat is as sensitive as an identity — `{email: supplier}` is exactly
      // the mapping the auction exists to hide — so a supplier may read only
      // their own, and only the auctioneer may enumerate them. Note the read
      // rule matches on the address rather than on `hasSeat()`: someone whose
      // seat was revoked still needs to be able to establish that fact.
      match /seats/{email} {
        allow get: if isOwner()
          || (request.auth != null && 'email' in request.auth.token && request.auth.token.email == email);
        allow list: if isOwner();

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['publicKey', 'role', 'invitedAt'])
          && request.resource.data.role in ['owner', 'bidder', 'viewer'];

        // The seat holder stamps their own first sign-in, so the auctioneer's
        // roster can distinguish "invited" from "has actually got in" — the
        // question they need answered in the minutes before an auction opens.
        // Nothing else about a seat may be changed by its holder: the slot and
        // the role it grants stay exactly as the auctioneer wrote them.
        allow update: if request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email == email
          && request.auth.token.email_verified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid', 'claimedAt'])
          && request.resource.data.claimedUid == request.auth.uid;

        allow delete: if isOwner();
      }
    }
  }
}
