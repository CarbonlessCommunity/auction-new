rules_version = '2';

// Best-effort enforcement for a Spark-plan (no Cloud Functions) deployment.
// There is no trusted server: everything here is what a signed-in client can be
// made to prove using only its own auth token and document reads.
//
// Identity is an email address on the sign-in token. Two of them — the admins,
// listed in `isAdmin()` below and mirrored from `src/shared/admins.ts` — run
// every auction: they create auctions and provision every participant's
// email/password account. A participant is admitted by a *seat* the admin wrote
// at `auctions/{id}/seats/{their-email}`; nothing in a URL grants access.
//
// `email_verified` is required for an *admin* (an admin address is one anybody
// could register here, so the inbox check is what makes it trustworthy) but NOT
// for a participant: a participant account can only be created by an admin, so
// the admin is already the authority on which address maps to which seat.
//
// What this CANNOT do — deliberately accepted trade-offs, see project notes:
//   - Blind Last-Call secrecy: a technical reader can list `events` directly
//     and see hidden bids; the client only hides them at render time.
//   - Bid arithmetic (beats-current-best, extended-time math, min-step):
//     enforced client-side only (`validateInbound`), not re-derived here.
// What this DOES enforce: only an auctioneer can issue admin events, only a
// seated bidder can bid as itself and only while the clock is running (not
// paused), a supplier can withdraw only their own bid, an observer can write
// nothing at all, events are append-only, only an admin can create an auction
// or read a participant's stored password, and — see `identities` below — a
// supplier cannot read any other supplier's name or email by any route.
//
// The one exception to append-only: an admin may delete an auction that has
// first been *archived* (a flag on the auction doc), document by document,
// because Firestore has no recursive delete. A live auction's log cannot be
// touched by anyone.
service cloud.firestore {
  match /databases/{database}/documents {

    match /auctions/{auctionId} {

      function auction() {
        return get(/databases/$(database)/documents/auctions/$(auctionId)).data;
      }

      // ---- identity -----------------------------------------------------
      //
      // The two people who run auctions. Token-only, so this is cheap and
      // works before any document exists (auction creation). Kept in sync
      // with `src/shared/admins.ts` by hand — rules cannot import it.
      function isAdmin() {
        return request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email_verified == true
          && request.auth.token.email in [
            'jeffreyhuang165@gmail.com',
            'craig.r.schuttenberg@gmail.com'
          ];
      }

      // The writer's seat, looked up by the address on their token. Keyed by
      // email rather than by browser session, so revoking it (deleting the
      // doc) takes effect immediately and everywhere, and a second device
      // needs no new capability.
      function seatPath() {
        return /databases/$(database)/documents/auctions/$(auctionId)/seats/$(request.auth.token.email);
      }

      // No `email_verified` here — see the file header. A seated address is one
      // an admin assigned to an account the admin created.
      function hasSeat() {
        return request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email != null
          && exists(seatPath());
      }

      function seat() {
        return get(seatPath()).data;
      }

      // An admin, or anyone an admin seated as an auctioneer.
      function isOwner() {
        return isAdmin() || (hasSeat() && seat().role == 'owner');
      }

      function isBidder() {
        return hasSeat() && seat().role == 'bidder';
      }

      // Archiving is the admin panel's "put it away" — and the precondition
      // for deleting, so a running auction's log can never be deleted by
      // mistake, only one that was first taken off the list.
      function isArchived() {
        return auction().get('archived', false) == true;
      }

      // An archived auction may be dismantled by an admin, one doc at a time.
      function canDismantle() {
        return isAdmin() && isArchived();
      }

      allow get: if request.auth != null;
      // Only an admin enumerates auctions (the admin panel's auction list).
      // A participant only ever opens one by id, from a link.
      allow list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.nextSeq == 0
        && request.resource.data.startedAt == null
        && request.resource.data.showResults == false;

      allow update: if (
        isOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        // seq only ever moves forward; mirror fields (name/startedAt/
        // auctionLength/showResults/ownerPublicKey) are cosmetic and owner-trusted.
        && request.resource.data.nextSeq >= resource.data.nextSeq
        // rules are frozen once the auction has actually started.
        && (resource.data.startedAt == null || request.resource.data.config == resource.data.config)
      ) || (
        // A bidder's own placeBid submit() bumps this same mirrored counter
        // (and, on Extended Time, auctionLength) alongside their event write —
        // both writes land in one commit. Bid arithmetic is already
        // client-trusted (see isAllowedBid), so trust the paired bump too:
        // only nextSeq/auctionLength may move, and nextSeq by exactly one.
        //
        // auctionLength is the clock every participant reads, so unlike the
        // other mirror fields it is NOT owner-trusted here and must be bounded:
        // a bidder who could write it freely would be able to end the auction
        // for everyone (0) or stall it indefinitely. Extended Time only ever
        // pushes the main clock back out to the threshold, so the largest
        // legitimate bump is the threshold itself, and it never moves backwards.
        isBidder()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextSeq', 'auctionLength'])
        && request.resource.data.nextSeq == resource.data.nextSeq + 1
        && request.resource.data.auctionLength >= resource.data.auctionLength
        && request.resource.data.auctionLength <= resource.data.auctionLength
             + resource.data.config.extendedTimeThresholdSec
      );

      // The auction doc goes last, after its subcollections — see canDismantle.
      allow delete: if isAdmin() && resource.data.get('archived', false) == true;

      // ---- events/{eventId} : append-only log -----------------------------
      match /events/{eventId} {
        allow get, list: if request.auth != null;
        allow update: if false;
        allow delete: if canDismantle();

        allow create: if request.auth != null
          && request.resource.data.seq == auction().nextSeq
          && isAllowedEvent();

        function isAllowedEvent() {
          let type = request.resource.data.type;
          let ownerOnly = type in
            ['setName', 'addUser', 'addLot', 'renameLot', 'startAuction',
             'pauseAuction', 'resumeAuction', 'showResults'];
          return (ownerOnly && isOwner())
            || (type == 'placeBid' && isAllowedBid())
            || (type == 'cancelBid' && isAllowedCancel());
        }

        // The auctioneer may withdraw any bid; a supplier only their own. A
        // cancellation names the bid's owner in `bidder` — rules cannot follow
        // `bidSeq` to the bid document, so this checks the *seat* against that
        // name, and the client fold refuses any cancellation whose named owner
        // is not the target bid's actual bidder. A supplier can therefore only
        // write a cancellation naming themselves, which can only ever take
        // effect on one of their own bids.
        function isAllowedCancel() {
          return isOwner() || (isBidder() && request.resource.data.bidder == seat().publicKey);
        }

        function isAllowedBid() {
          let data = request.resource.data;
          let withinWindow = auction().startedAt != null
            // small grace window for clock drift / in-flight requests, not a
            // meaningful security boundary given everything else here.
            && request.time.toMillis() / 1000 <= auction().startedAt + auction().auctionLength + 5
            // A paused clock takes no bids. `pausedAt` is mirrored off the
            // pause/resume events, so this holds against a hand-crafted write
            // too — the one piece of clock arithmetic the rules can do.
            && auction().get('pausedAt', null) == null;
          let onBehalf = 'placedBy' in data;
          let asSelf = isBidder() && seat().publicKey == data.bidder;
          return withinWindow && (onBehalf ? isOwner() : asSelf);
        }
      }

      // ---- users/{publicKey} : the public roster --------------------------
      //
      // Readable by any signed-in client, because a viewer resolves their own
      // slot here before anything else is known about them. That is only safe
      // because these docs carry nothing identifying — just the role, the
      // public label ("Supplier C") and the palette slot. Names and email
      // addresses live in `identities` and `seats`, both closed to a rival.
      match /users/{publicKey} {
        // The roster is derived client-side by folding `addUser` events, so
        // nothing legitimate queries this collection — except an admin
        // dismantling an archived auction, who has to find every doc.
        allow get: if request.auth != null;
        allow list: if isAdmin();

        allow create: if isOwner();
        // Immutable once written. Who *occupies* a slot is now a property of
        // the seat, not of this doc, so there is nothing here left to change.
        allow update: if false;
        allow delete: if canDismantle();
      }

      // ---- identities/{publicKey} : real names, access-controlled ---------
      //
      // The one collection in this app that is genuinely secret from a
      // supplier. Everything else — the log, the roster, the bids — is
      // readable by any signed-in client, so a supplier's firm cannot be
      // stored in any of them. It lives here instead, and this rule is what
      // enforces the auction's core promise: a bidder learns where their price
      // stands in the market, and never whose price it is standing against.
      //
      // Readable by the auctioneer (who runs the auction), an observer (the
      // buying side, who sees the auctioneer's screen), and the participant
      // themselves. Never by another bidder — not before the auction, not
      // during it, and not after results are released.
      match /identities/{publicKey} {
        allow get: if isOwner()
          || (hasSeat() && (seat().role == 'viewer' || seat().publicKey == publicKey));
        allow list: if isOwner() || (hasSeat() && seat().role == 'viewer');
        allow create: if isOwner();
        // Immutable: a rename would otherwise let the auctioneer's screen and a
        // supplier's own screen disagree about who bid what after the fact.
        allow update: if false;
        allow delete: if canDismantle();
      }

      // ---- seats/{email} : who may occupy which slot ----------------------
      //
      // The access-control table, keyed by the participant's address so that a
      // sign-in token can be checked against it directly. Deleting a seat is
      // how an admin revokes someone; creating one under a different address is
      // how they correct a typo.
      //
      // A seat is as sensitive as an identity — `{email: supplier}` is exactly
      // the mapping the auction exists to hide — so a supplier may read only
      // their own, and only an auctioneer may enumerate them. Note the read
      // rule matches on the address rather than on `hasSeat()`: someone whose
      // seat was revoked still needs to be able to establish that fact.
      match /seats/{email} {
        allow get: if isOwner()
          || (request.auth != null && 'email' in request.auth.token && request.auth.token.email == email);
        allow list: if isOwner();

        allow create: if isOwner()
          && request.resource.data.keys().hasOnly(['publicKey', 'role', 'invitedAt'])
          && request.resource.data.role in ['owner', 'bidder', 'viewer'];

        // The seat holder stamps their own first sign-in, so the roster can
        // distinguish "invited" from "has actually got in". Nothing else about
        // a seat may be changed by its holder: the slot and the role it grants
        // stay exactly as the auctioneer wrote them.
        allow update: if request.auth != null
          && 'email' in request.auth.token
          && request.auth.token.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid', 'claimedAt'])
          && request.resource.data.claimedUid == request.auth.uid;

        allow delete: if isOwner();
      }

      // ---- credentials/{publicKey} : generated participant passwords ------
      //
      // The admin panel creates each supplier/client account with a generated
      // password and keeps it here so either admin can re-read and relay it
      // later. Closed to everyone but an admin: a participant must never read
      // another's password, and a viewer has no business here at all.
      match /credentials/{publicKey} {
        allow read, write: if isAdmin();
      }
      // (seats and credentials are admin-deletable already — revoking is a
      // seat delete — so dismantling needs nothing more from them.)

      // ---- presence/{uid} : heartbeats -----------------------------------
      //
      // Each open browser writes its own doc every half minute, stamped with
      // the server's clock (`at == request.time` is what forces the stamp to
      // be the server's, not the client's). Read back, the stamp tells that
      // browser how far its own clock is off; listed by the auctioneer, the
      // stamps say who is connected right now.
      //
      // Carries only the writer's public slot key, which must be the one their
      // seat grants — a bidder cannot heartbeat as a rival. Nothing here names
      // anyone, but the set of who-is-online is the auctioneer's to see, not a
      // rival's, so only an auctioneer may list it.
      match /presence/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow list: if isOwner();

        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['publicKey', 'at'])
          && request.resource.data.at == request.time
          && (isAdmin() || (hasSeat() && request.resource.data.publicKey == seat().publicKey));

        allow delete: if (request.auth != null && request.auth.uid == uid) || canDismantle();
      }
    }
  }
}
